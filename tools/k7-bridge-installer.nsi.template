; K7 PC Bridge Windows Installer
; Generated by build_pc_bridge.py — do not edit by hand.

Unicode True

!define APP_NAME    "K7 Bridge"
!define APP_EXE     "k7-bridge.exe"
!define APP_VERSION "${VERSION}"
!define INST_DIR    "$LOCALAPPDATA\K7 Bridge"

Name "${APP_NAME} ${APP_VERSION}"
OutFile "${OUTFILE}"
InstallDir "${INST_DIR}"
RequestExecutionLevel user
ShowInstDetails hide
ShowUnInstDetails hide

; Modern UI
!include "MUI2.nsh"
!define MUI_ABORTWARNING
!define MUI_ICON "${NSISDIR}\Contrib\Graphics\Icons\modern-install.ico"
!define MUI_UNICON "${NSISDIR}\Contrib\Graphics\Icons\modern-uninstall.ico"

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES

!insertmacro MUI_LANGUAGE "English"

Section "Install"
    SetOutPath "${INST_DIR}"
    File "${SRCDIR}\k7-bridge.exe"
    File "${SRCDIR}\README.txt"
    ; Desktop shortcut
    CreateShortcut "$DESKTOP\K7 Bridge.lnk" "${INST_DIR}\${APP_EXE}" \
        "" "${INST_DIR}\${APP_EXE}" 0 SW_SHOWMINIMIZED

    ; Start Menu shortcuts
    CreateDirectory "$SMPROGRAMS\K7 Bridge"
    CreateShortcut "$SMPROGRAMS\K7 Bridge\K7 Bridge.lnk" "${INST_DIR}\${APP_EXE}" \
        "" "${INST_DIR}\${APP_EXE}" 0 SW_SHOWMINIMIZED
    CreateShortcut "$SMPROGRAMS\K7 Bridge\Uninstall K7 Bridge.lnk" \
        "${INST_DIR}\uninstall.exe"

    ; Uninstaller
    WriteUninstaller "${INST_DIR}\uninstall.exe"

    ; Add/Remove Programs entry
    WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\K7Bridge" \
        "DisplayName" "${APP_NAME} ${APP_VERSION}"
    WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\K7Bridge" \
        "UninstallString" "${INST_DIR}\uninstall.exe"
    WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\K7Bridge" \
        "DisplayVersion" "${APP_VERSION}"
    WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\K7Bridge" \
        "Publisher" "bitbarista"
    WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\K7Bridge" \
        "NoModify" 1
    WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\K7Bridge" \
        "NoRepair" 1
SectionEnd

Section "Uninstall"
    Delete "${INST_DIR}\k7-bridge.exe"
    Delete "${INST_DIR}\README.txt"
    Delete "${INST_DIR}\uninstall.exe"
    RMDir  "${INST_DIR}"

    Delete "$DESKTOP\K7 Bridge.lnk"
    Delete "$SMPROGRAMS\K7 Bridge\K7 Bridge.lnk"
    Delete "$SMPROGRAMS\K7 Bridge\Uninstall K7 Bridge.lnk"
    RMDir  "$SMPROGRAMS\K7 Bridge"

    DeleteRegKey HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\K7Bridge"
SectionEnd
